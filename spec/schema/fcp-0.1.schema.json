{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcp.dev/schema/fcp-0.1.schema.json",
  "title": "Fast Context Protocol 0.1",
  "type": "object",
  "$defs": {
    "intent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "params": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["maxTokens", "maxBytes"],
      "properties": {
        "maxTokens": { "type": "integer", "minimum": 1 },
        "maxLatencyMs": { "type": "integer", "minimum": 1 },
        "maxBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "contextRequest": {
      "type": "object",
      "required": ["requestId", "intent", "budget"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "intent": { "$ref": "#/$defs/intent" },
        "consumer": { "type": "object" },
        "budget": { "$ref": "#/$defs/budget" },
        "requirements": { "type": "object" },
        "knownContext": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "additionalProperties": false
    }
  }
}
